VOLATILITY3_REPO_URL=https://github.com/volatilityfoundation/volatility3
VOLATILITY3_BRANCH=stable
VOLATILITY3_REPO_PATH=.cache/volatility3
# Git update runs after MCP transport opens. A bad update keeps the latest
# local valid Git revision; pip is only used when no valid Git source exists.
VOLATILITY3_UPDATE_MODE=background
VOLATILITY3_FETCH_TIMEOUT_SECONDS=60
VOLATILITY3_CLONE_TIMEOUT_SECONDS=180
VOLATILITY3_PIP_FALLBACK=true
VOLATILITY3_KEEP_GOOD_REVISIONS=2
# Optional semicolon/comma separated trusted local clones. No disk-wide scan.
VOLATILITY3_LOCAL_REPOS=
VOLATILITY3_ALLOWED_ORIGINS=https://github.com/volatilityfoundation/volatility3
# Optional local Windows ISF store. Relative paths resolve from this .env file.
MEMOXIDE_SYMBOLS_ROOT=symbols/windows
